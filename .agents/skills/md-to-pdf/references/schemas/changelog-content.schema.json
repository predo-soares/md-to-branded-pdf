{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["title", "releases"],
  "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "releases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["version", "date", "categories"], "additionalProperties": false,
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "intro": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["name", "markdown"], "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1}, "markdown": {"type": "string", "minLength": 1}}
        }}
      }
    }}
  }
}
