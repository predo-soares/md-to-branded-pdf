{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "required": ["title", "sections"], "additionalProperties": false,
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "sections": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["heading", "markdown"], "additionalProperties": false,
      "properties": {"heading": {"type": "string", "minLength": 1},
                     "markdown": {"type": "string", "minLength": 1}}
    }}
  }
}
